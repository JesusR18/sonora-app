# Copia este archivo como .env y llena los valores (Supabase → Project Settings → API).
# .env NO se sube a ningún lado: contiene la llave secreta.

# URL del proyecto, ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Llave pública (anon / publishable). Va al navegador; está protegida por las reglas RLS.
SUPABASE_ANON_KEY=

# Llave secreta (service_role / secret). SOLO la usa el servidor para importar noticias y contar reproducciones.
SUPABASE_SERVICE_ROLE_KEY=

# Cada cuántos minutos el servidor busca noticias nuevas en los RSS de música
NEWS_REFRESH_MINUTES=15
